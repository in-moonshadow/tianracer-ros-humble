<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tianracer_navigation2</name>
  <version>0.0.0</version>
  <description>tianracer 的 Nav2 导航栈配置与启动（多套规划器/控制器参数档、按赛道自动选档、cmd_vel→ackermann_cmd 转换）</description>
  <maintainer email="tianbot@todo.todo">tianbot</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>tianracer_description</depend>

  <!-- script/cmd_vel_to_ackermann_drive.py 需要 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
